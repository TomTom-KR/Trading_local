# Trading Local - Konfiguration
# Diese Datei nach ".env" kopieren und anpassen. ".env" wird nie nach Git eingecheckt.

# --- Webservice -----------------------------------------------------------------------------
TL_HOST=127.0.0.1
TL_PORT=8000
TL_OPEN_BROWSER=true

# --- Lokales LLM (Ollama) ---------------------------------------------------------------------
TL_OLLAMA_MODEL=qwen3.5:9b
# TL_OLLAMA_HOST=http://127.0.0.1:11434
# Gleicher Wert wie die Windows-Umgebungsvariable OLLAMA_CONTEXT_LENGTH (sonst lädt Ollama das Modell neu)
TL_OLLAMA_NUM_CTX=4096
TL_OLLAMA_TEMPERATURE=0.1

# --- E-Mail-Alarme ----------------------------------------------------------------------------
# smtp = echte Mails senden | file = Mails als .eml nach data/outbox schreiben | off = keine Mails
TL_MAIL_MODE=file
TL_SMTP_HOST=mail.gmx.net
TL_SMTP_PORT=465
# ssl (Port 465) oder starttls (Port 587)
TL_SMTP_SECURITY=ssl
TL_SMTP_USER=absender@example.com
TL_SMTP_PASSWORD=
TL_MAIL_FROM=absender@example.com
TL_MAIL_TO=empfaenger@example.com

# --- Simulation -------------------------------------------------------------------------------
TL_BASE_CURRENCY=EUR
TL_START_CAPITAL=100000

# --- Sonstiges --------------------------------------------------------------------------------
TL_TIMEZONE=Europe/Berlin
TL_LOG_LEVEL=INFO
